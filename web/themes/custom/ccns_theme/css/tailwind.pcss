@import "tailwindcss";
@plugin "daisyui" {
  themes: lofi;
}
@theme {
  --color-success: #6df78a;
  --color-info: #FF4D4D;
  --color-warning: #FF4D4D;
  --color-error: #f64d4d;
}
@layer base {
  input {
    @apply border w-full p-2;
  }
  textarea {
    @apply border w-full p-2;
  }
  div.form-item {
    @apply mb-2;
  }
  div.form-item div#edit-body-0--description,
  div.form-item div.description {
    @apply text-xs text-gray-500;
  }
  h1, h2, h3 {
    @apply font-bold;
  }
  div.page-not-found {

  }
  #drupal-off-canvas-wrapper .ui-dialog-titlebar {
    @apply p-2;
  }
  #drupal-off-canvas-wrapper .ui-dialog-titlebar::before {
    @apply hidden;
  }

}

@layer components {

  header {
    @apply my-3 mx-2;
    padding-top: env(safe-area-inset-top,0);
  }
  header,
  footer {
    @apply text-xs;
  }
  footer {
    @apply mt-3;
  }
  header .logo {
    @apply focus:outline-2 focus:outline-offset-2 focus:outline-purple-500;
    img {
      @apply w-20;
    }
  }

  header .user-picture {
    @apply inline-block ml-2;
  }
  header .user-picture img {
    @apply w-[26px] rounded-full;
  }
  header .user-links a {
    @apply p-0 align-middle;
  }
  header .user-links a.login {
    @apply btn btn-warning px-2 btn-xs btn-outline border-2 no-underline h-[26px] hover:text-black
  }

  #block-ccns-theme-headermenu a,
  #block-ccns-theme-footermenu a,
  .user-links a {
    @apply link link-info p-1 active:decoration-purple-600/80 active:text-primary;
  }
  #block-ccns-theme-footermenu code {
    font-size: 0.85em;
    @apply text-center block mt-2;
  }
  #block-ccns-theme-footer {
    @apply mt-3 mx-2
  }
  #block-ccns-theme-footer ul {
    @apply menu menu-horizontal p-0;
  }
  #block-ccns-theme-footer ul li > a {
    @apply no-underline link link-info p-2 active:decoration-purple-600/80 active:text-primary text-sm;
  }

  .chat .chat-bubble p {
    @apply m-0;
  }

  main {
    @apply text-sm m-2;
  }
  main a {
    @apply underline underline-offset-2 decoration-purple-600/30 decoration-2 transition active:decoration-purple-600/80 active:bg-purple-600/30 focus:bg-purple-600/30 hover:decoration-purple-600/80  hover:bg-purple-600/30;
  }
  main code {
    @apply text-xs;
  }
  main h1 {
    @apply text-lg;
  }
  main .node h1 {
    @apply text-2xl;
  }
  /* CCNS link */
  main .ccns-link strong.text-sm > a {
    @apply no-underline;
  }
  main .ccns-link small > a {
    @apply break-all underline-offset-2 decoration-1 inline-block;
  }

  article h2 {
    @apply text-xl;
  }
  article h3 {
    @apply text-lg;
  }
  article hr {
    @apply mb-4;
  }
  article p {
    @apply mb-4 text-gray-950;
  }
  article ul {
    @apply mb-4 pl-4 list-disc;
  }
  article ul li {

  }
  article ul > li > ul {
    @apply mb-0 pl-4 list-inside list-disc;
  }
  article ul > li > ul > li {
    list-style-type: circle;
  }

  #block-ccns-theme-primary-local-tasks ul {
    @apply p-0
  }
  [id$="-local-tasks"] ul {
    @apply p-0 menu menu-horizontal;
  }
  [id$="-local-tasks"] ul li {
    @apply bg-blue-100 mb-1 md:mb-0 mr-1;
  }
  [id$="-local-tasks"] ul li a {
    @apply no-underline focus:underline focus:underline-offset-1 focus:decoration-4 active:underline-offset-4 hover:decoration-4;
  }
  [id$="-local-tasks"] ul li a.is-active {
    @apply underline underline-offset-1 decoration-4;
  }

  nav.pager {
    @apply mt-8 text-center text-sm;
    li {
      @apply border-0!;
    }
    li.is-active {
      @apply bg-slate-200!;
    }
  }

  #block-ccns-theme-content header {
    @apply mx-0;
  }
  /* Notification inbox in header */
  .danse-user-notification-widget .views-row,
  .danse-user-notification-widget p {
    @apply hidden;
  }
  .danse-user-notification-widget .badge {
    font-size: 10px;
  }

  .comments {
    .chat {
      @apply bg-purple-300/5;
      .chat-bubble {
        @apply px-2! py-1! bg-white! min-h-auto!;
      }
      .chat-footer {
        @apply w-full flex;
        code {
          @apply flex-none;
        }
        a {
          @apply flex-none;
        }
        .comment__links {
          @apply grow flex gap-x-1 justify-end;
        }
      }
    }
    .indented {
      @apply ml-4;
    }
    form.comment-link-comment-form {
      textarea#edit-comment-body-0-value {
        @apply p-2 w-full text-sm text-gray-900 focus:ring-0 focus:outline-none bg-purple-50;
      }
      button.form-submit {
        @apply btn btn-warning btn-sm btn-block text-white border-0;
      }
    }
  }

  .frontpage-feed-filter {
    @apply border-b-2 border-slate-200 mb-2;
    ul {
      @apply flex gap-2;
      li {
        @apply basis-1/3 text-center bg-slate-50 py-2;
        &.active {
          @apply bg-slate-200;
        }
      }
    }
  }

  form {
    fieldset {
      @apply fieldset;
      legend {
        @apply fieldset-legend;
      }
    }
    .form-item-search-api-fulltext-op {
      label {
        @apply label;
      }
      select {
        @apply select;
      }
    }
    .form-item-search-api-fulltext-searched-fields {
      label {
        @apply label;
      }
      select {
        @apply select min-h-fit;
      }
    }
    button.form-submit {
      @apply btn btn-warning border-0 text-white w-full;
    }
  }
  .search-result {
    @apply my-4;
  }
}
